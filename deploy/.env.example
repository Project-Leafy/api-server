# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다.

# 이 PC 의 Tailscale IPv4 (Tailscale 앱 > 이 기기 > Tailscale addresses)
TAILSCALE_IP=100.107.95.115

# 이미지 태그 (비우면 latest)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Windows 에 설치한 PostgreSQL 의 계정 (README 의 DB 준비 단계에서 만든 값)
DB_USERNAME=leafy_user
DB_PASSWORD=

# JWT 서명 키: 48바이트 난수를 base64 로 인코딩한 값. PowerShell 에서 생성:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET_KEY=

# MinIO 관리자 계정 (앱도 이 계정으로 접속). 비밀번호는 8자 이상.
STORAGE_ACCESS_KEY=leafy-minio
STORAGE_SECRET_KEY=

# 선택: 없으면 해당 기능만 동작하지 않는다.
PLANT_ID_API_KEY=
OPENAI_API_KEY=
NONGSARO_API_KEY=
AIR_PURIFIY_KEY=
OPEN_WEATHER_API_KEY=
